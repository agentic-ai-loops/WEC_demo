{% extends "_layouts/base.html.j2" %}
{#- One CustomerAction: every field, its relations as links, the reviews pointing at it. -#}
{% block title %}actions/{{ params.id }}{% endblock %}
{% block main %}
{%- import "_partials/rich.html.j2" as rich with context -%}
{%- set e = data.e -%}
{% call rich.panel(e.label | truncate(70, true, '…', 0), "CustomerAction · actions/" ~ e.id, cls="panel-strong panel-head") %}
{%- if e.get('hidden') %}<p class="warn">hidden: not on the public site</p>{% endif %}
{% call rich.kv() %}
{{ rich.row('id', rich.value(e.id)) }}
{{ rich.row('type', rich.value(e.type)) }}
{{ rich.row('label', rich.value(e.label)) }}
{% call rich.row('href') %}<a href="{{ e.href }}">{{ e.href | truncate(70, true, '…', 0) }}</a>{% endcall %}
{% endcall %}
{% endcall %}
{% call rich.panel("relations") %}{% call rich.kv() %}
{% call rich.row('channel') %}{{ rich.ref('contacts', e.channel.id) }}{{ rich.hidden_tag(e.channel) }}{% endcall %}
{% call rich.row('services') %}{{ rich.refs('services', e.services) }}{% endcall %}
{% endcall %}{% endcall %}
{{ rich.tail('actions', e) }}
{% endblock %}
