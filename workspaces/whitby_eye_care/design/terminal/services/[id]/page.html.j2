{% extends "_layouts/base.html.j2" %}
{#- One Service: every field, its relations as links, the reviews pointing at it. -#}
{% block title %}services/{{ params.id }}{% endblock %}
{% block main %}
{%- import "_partials/rich.html.j2" as rich with context -%}
{%- set e = data.e -%}
{% call rich.panel(e.name | truncate(70, true, '…', 0), "Service · services/" ~ e.id, cls="panel-strong panel-head") %}
{%- if e.get('hidden') %}<p class="warn">hidden: not on the public site</p>{% endif %}
{% call rich.kv() %}
{{ rich.row('id', rich.value(e.id)) }}
{{ rich.row('name', rich.value(e.name)) }}
{{ rich.row('summary', rich.value(e.summary)) }}
{{ rich.row('description', rich.value(e.description)) }}
{{ rich.row('audience', rich.value(e.audience)) }}
{% endcall %}
{% endcall %}
{% call rich.panel("relations") %}{% call rich.kv() %}
{% call rich.row('category') %}{{ rich.ref('service_categories', e.category.id) }}{% endcall %}
{% call rich.row('image') %}{{ rich.asset_ref(e.image) }}{% endcall %}
{% call rich.row('faqs') %}{{ rich.refs('faqs', e.faqs) }}{% endcall %}
{% call rich.row('actions') %}{{ rich.refs('actions', e.actions) }}{% endcall %}
{% endcall %}{% endcall %}
{{ rich.tail('services', e) }}
{% endblock %}
