{% extends "_layouts/base.html.j2" %}
{#- One StaffMember: every field, its relations as links, the reviews pointing at it. -#}
{% block title %}staff/{{ params.id }}{% endblock %}
{% block main %}
{%- import "_partials/rich.html.j2" as rich with context -%}
{%- set e = data.e -%}
{% call rich.panel(e.name | truncate(70, true, '…', 0), "StaffMember · staff/" ~ e.id, cls="panel-strong panel-head") %}
{%- if e.get('hidden') %}<p class="warn">hidden: not on the public site</p>{% endif %}
{% call rich.kv() %}
{{ rich.row('id', rich.value(e.id)) }}
{{ rich.row('name', rich.value(e.name)) }}
{{ rich.row('role', rich.value(e.role)) }}
{{ rich.row('credentials', rich.value(e.credentials)) }}
{{ rich.row('bio', rich.value(e.bio)) }}
{{ rich.row('languages', rich.value(e.languages)) }}
{% endcall %}
{% endcall %}
{% call rich.panel("relations") %}{% call rich.kv() %}
{% call rich.row('photo') %}{{ rich.asset_ref(e.photo) }}{% endcall %}
{% endcall %}{% endcall %}
{{ rich.tail('staff', e) }}
{% endblock %}
