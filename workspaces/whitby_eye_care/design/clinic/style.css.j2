:root { --accent: {{ config.options.accent }}; }
body { font-family: system-ui, sans-serif; margin: 0; color: #222; line-height: 1.5; }
header, main, footer { max-width: 60rem; margin: 0 auto; padding: 1rem; }
.brand { display: flex; align-items: center; gap: .75rem; color: var(--accent); font-weight: 700; text-decoration: none; }
.brand img { height: 3rem; }
.hero img { width: 100%; max-height: 22rem; object-fit: cover; }
.services li { margin: .25rem 0; }
.button { display: inline-block; padding: .5rem 1rem; background: var(--accent); color: #fff; border-radius: .25rem; text-decoration: none; }
img.service { max-width: 20rem; }
.preview { background: #fff3cd; margin: 0; padding: .5rem 1rem; text-align: center; }
footer { border-top: 1px solid #ddd; font-size: .9rem; }
.contacts { list-style: none; padding: 0; }
