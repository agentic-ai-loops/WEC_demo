# the intelliw server (`svr start`): /mcp, /graphql and /health on one port
SVR_HOST=0.0.0.0
SVR_PORT=8000
# svr.pid, worker.pid, logs, and the rendered sites in sites/ (relative to this file)
INTELLIW_RUN_DIR=run
# workspace served by the server and used by the `business` and `render` CLIs
# (relative to this file)
WORKSPACE=workspaces/whitby_eye_care
# the re-render job queue (rq); `make redis-start` runs Redis in docker
REDIS_URL=redis://localhost:6379/0
# rq-dashboard (`make dashboard-start`): its own port, never SVR_PORT. It has no login
# unless both are set, and it can delete and requeue jobs.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=9181
DASHBOARD_USERNAME=
DASHBOARD_PASSWORD=
